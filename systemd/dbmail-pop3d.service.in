[Unit]
Description=DBMail pop3 Server
After=network.target network-online.target mysqld.service postgresql.service

[Service]
Type=notify
ExecStart=@sbindir@/dbmail-pop3d -D
Restart=always
RestartSec=3s
StartLimitBurst=3
StartLimitIntervalSec=15
SyslogFacility=mail

[Install]
WantedBy=multi-user.target
